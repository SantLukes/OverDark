# Aplicação
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo

# Docker
# UID/GID do seu usuário no host (id -u / id -g) — evita arquivos com dono root.
UID=1000
GID=1000
WEB_PORT=8086
# Porta do MySQL exposta no host (para DBeaver, PhpStorm etc.)
DB_HOST_PORT=3307

# Logs (ver docs/observabilidade.md)
LOG_PATH=storage/logs/overdark.log
LOG_LEVEL=debug
# Incoming Webhook do Slack. Vazio = não envia. NUNCA versione este valor.
SLACK_WEBHOOK_URL=
# A partir de qual nível vai para o Slack (error recomendado; info para demonstrar eventos de sucesso)
LOG_SLACK_LEVEL=error

# Banco — conexão da aplicação (de dentro da rede do Docker)
DB_HOST=db
DB_PORT=3306
DB_DATABASE=overdark
DB_USERNAME=overdark
DB_PASSWORD=overdark
DB_ROOT_PASSWORD=root
# Segundos que uma gravação espera por um registro travado antes de desistir (padrão do MySQL: 50)
DB_LOCK_WAIT_TIMEOUT=3
